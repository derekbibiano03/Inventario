<UserControl x:Class="Inventario.Desktop.Views.UserControllers.Adquisiciones_Servicios.Requisiciones.AgregarRequisicionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventario.Desktop.Views.UserControllers.Adquisiciones_Servicios.Requisiciones"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="AUTO"/>
            <ColumnDefinition Width="AUTO"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="AUTO"/>
            <RowDefinition Height="AUTO"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="100,100,10,10">

            <TextBlock Text="SELECCIONAR RAZON SOCIAL:" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox 
            x:Name="cmbOpciones"
            DisplayMemberPath="Texto"
            SelectedValuePath="Valor"
            Width="380" 
            Height="30"
            HorizontalAlignment="Left"/>

            <TextBlock Text="SELECCIONAR PROYECTO:" FontWeight="Bold" Margin="0,10,0,10" />
            <ComboBox 
            ItemsSource="{Binding Ubicaciones}"
            DisplayMemberPath="NombreProyecto"
            SelectedValuePath="IdUbicacion"
            SelectedValue="{Binding IdUbicacionSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            Width="380" 
            Height="30"
            HorizontalAlignment="Left"
            Margin="0,0,0,10"/>

            <TextBlock Text="SELECCIONAR TIPO DE REQUISICION:" FontWeight="Bold" Margin="0,10,0,10" />
            <ComboBox 
                x:Name="cmbOpcionesTipo"
                DisplayMemberPath="Texto"
                SelectedValuePath="Valor"
                Width="380" 
                Height="30"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"/>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="AUTO"/>
                        <ColumnDefinition Width="AUTO"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="0,10,0,0" Text="SELECCIONAR LA REQUISICION COMPLETA" />
                    <!-- 
                        <TextBox Grid.Column="0" 
                        Text="{Binding , Mode=TwoWay}" 
                        IsReadOnly="True"     
                        Height="30"
                        Width="250"
                        Margin="0,30,0,0"
                        VerticalContentAlignment="Center" 
                        Background="#F5F5F5" 
                        Padding="5,0"/>
                    -->
                    <Button Grid.Column="1" 
                        Content="Buscar Archivo..." 
                        Command="{Binding }" 
                        Width="120" 
                        Margin="10,30,0,0" 
                        Height="30"/>               
                </Grid>
                
            </StackPanel>

            <Button 
                Content="DAR DE ALTA LA REQUISICION"
                Width="250" 
                Height="35"
                HorizontalAlignment="Left"
                Margin="0,30,0,0"
                Background="#007ACC" 
                Foreground="White" 
                FontWeight="Bold" />

        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="100,100,10,10" Orientation="Vertical">

            <TextBlock Text="BUSCAR Y SELECCIONAR ECONOMICOS (SELECCIÓN MÚLTIPLE OPCIONAL):" 
                FontWeight="SemiBold" 
                Margin="0,0,0,5"/>

            <TextBox Text="{Binding TextoBusquedaId, UpdateSourceTrigger=PropertyChanged}" 
                Tag="Buscar por ID..." 
                Height="30" 
                VerticalContentAlignment="Center" 
                Margin="0,0,0,5"
                Padding="5,0"/>

            <ListBox ItemsSource="{Binding EconomicosFiltrados}" 
                    Height="200" 
                     Width="500"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                    Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IdEconomico}" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,10,0"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding Descripcion}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="GENERAR ARCHIVO EXCEL" 
                Width="250" 
                    HorizontalAlignment="Left"
                Height="35" 
                Margin="0,10,0,0"
                Background="#4B803E" 
                Foreground="White" 
                FontWeight="Bold" 
                BorderBrush="{x:Null}"/>

        </StackPanel>
    </Grid>
</UserControl>
