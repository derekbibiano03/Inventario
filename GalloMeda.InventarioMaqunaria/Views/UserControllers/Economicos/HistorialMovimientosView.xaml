                            <ComboBox Width="110" Height="25" Margin="0,2,0,0" ItemContainerStyle="{StaticResource EstiloDropdownExcel}" ItemsSource="{Binding DataContext.FiltroTipoEquipoOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton BorderThickness="1" Background="White" BorderBrush="Gray" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Content="Filtrar ▾"/>
                                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" MinWidth="180" Padding="5">
