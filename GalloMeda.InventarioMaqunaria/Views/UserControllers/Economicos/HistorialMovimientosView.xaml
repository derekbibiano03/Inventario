                            <ComboBox Width="110" Height="25" Margin="0,2,0,0" ItemContainerStyle="{StaticResource EstiloDropdownExcel}" ItemsSource="{Binding DataContext.FiltroMarcasOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}">
