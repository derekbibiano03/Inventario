<UserControl x:Class="Inventario.Desktop.Views.UserControllers.Economicos.EconomicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventario.Desktop.Views.UserControllers.Economicos"
             xmlns:helpers="clr-namespace:Inventario.Desktop.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="950">

    <UserControl.Resources>
        <helpers:UpperCaseConverter x:Key="UpperCaseConverter"/>

        <!-- Palette / Variables de Estilo -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E88E5"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1565C0"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        <SolidColorBrush x:Key="BorderColorBrush" Color="#E0E0E0"/>

        <!-- Estilo Base para Botones Principales -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Base para Botones Secundarios -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <!-- Template Reutilizable Corregido (ItemsControl reemplaza a ItemsPresenter) -->
        <ControlTemplate x:Key="FiltroExcelComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" 
                              BorderThickness="1" 
                              Background="White" 
                              BorderBrush="{StaticResource BorderColorBrush}" 
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" 
                              ClickMode="Press" 
                              Content="Filtrar ▾" 
                              FontSize="11"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Height="22"
                              Padding="4,0"/>

                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" MinWidth="180" CornerRadius="4" Padding="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#20000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Buscar:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="24" Margin="0,0,0,6" Padding="4,2" FontSize="12"
                                     Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                              ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <!-- Template para los CheckBox -->
        <DataTemplate x:Key="ItemFiltroCheckBoxTemplate">
            <CheckBox Content="{Binding Nombre}" 
                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="2,2" FontSize="11"/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior de Herramientas -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Limpiar Filtros" 
                        Command="{Binding LimpiarFiltrosCommand}" 
                        Style="{StaticResource BtnSecondary}" 
                        Margin="0,0,10,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="Exportar a Excel" 
                    Command="{Binding ExportarExcelCommand}" 
                    Style="{StaticResource BtnPrimary}"/>
        </Grid>

        <!-- Contenedor del DataGrid -->
        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderColorBrush}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding VistaEconomicos}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      Background="White"
                      RowHeight="38"
                      ColumnHeaderHeight="55"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Binding="{Binding IdEconomico, Converter={StaticResource UpperCaseConverter}}" Width="110">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="ID" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="100" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaId, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroIdOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Descripción -->
                    <DataGridTextColumn Width="280" Binding="{Binding Descripcion}" IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Descripción" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="120" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaDescripcion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroDescripcionesOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Marca -->
                    <DataGridTextColumn Width="140" Binding="{Binding NombreMarca}" IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Marca" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="100" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaMarca, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroMarcasOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Modelo -->
                    <DataGridTextColumn Header="Modelo" Width="120" Binding="{Binding Modelo}" IsReadOnly="True"/>

                    <!-- No. Serie -->
                    <DataGridTextColumn Width="140" Binding="{Binding Serie}" IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="No. Serie" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="100" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaSerie, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroSeriesOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tipo de Equipo -->
                    <DataGridTextColumn Width="130" Binding="{Binding IdTipoEquipoNavigation.DescripcionTipoEquipo}" IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Tipo Equipo" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="110" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaTipoEquipo, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroTipoEquipoOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ubicación -->
                    <DataGridTextColumn Width="140" Binding="{Binding IdUbicacionNavigation.NombreProyecto}" IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Ubicación" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ComboBox Width="110" 
                                              Template="{StaticResource FiltroExcelComboBoxTemplate}"
                                              Tag="{Binding DataContext.BusquedaUbicacion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.FiltroUbicacionesOpciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ItemTemplate="{StaticResource ItemFiltroCheckBoxTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Acciones Unificadas -->
                    <DataGridTemplateColumn Header="Acciones" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Ver" 
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IdEconomico}"
                                            Style="{StaticResource BtnSecondary}"
                                            Padding="8,3" FontSize="11" Margin="2,0"/>

                                    <Button Content="Editar" 
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IdEconomico}"
                                            Style="{StaticResource BtnPrimary}"
                                            Padding="8,3" FontSize="11" Margin="2,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>