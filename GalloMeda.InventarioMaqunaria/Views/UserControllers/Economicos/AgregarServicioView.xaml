<UserControl x:Class="Inventario.Desktop.Views.UserControllers.Economicos.AgregarServicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventario.Desktop.Views.UserControllers.Economicos"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Estilo general para las etiquetas (TextBlock) -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo base para controles de entrada -->
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource InputControlStyle}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource InputControlStyle}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource InputControlStyle}"/>

        <!-- Estilo secundario para el Botón de Adjuntar -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0277BD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#01579B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo moderno para el Botón de Guardar -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D3B0E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" 
                    CornerRadius="8" 
                    Margin="20" 
                    Padding="25" 
                    MaxWidth="700" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Encabezado del Formulario -->
                    <TextBlock Text="Registro de Servicio de Mantenimiento" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#1A237E" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Ingrese los datos requeridos y adjunte los archivos correspondientes del servicio." 
                               FontSize="12" 
                               Foreground="#666666" 
                               Margin="0,0,0,20"/>

                    <Separator Background="#E0E0E0" Margin="0,0,0,20"/>

                    <!-- Grid de 2 Columnas para los Campos -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Columna 1, Fila 1: Económico -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="No. Económico:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Economicos}"
                                      DisplayMemberPath="IdEconomico"
                                      SelectedValuePath="IdEconomico"
                                      SelectedValue="{Binding NoEconomico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Columna 2, Fila 1: Fecha de Realización -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Fecha de Realización:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FechaMantenimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Columna 1, Fila 2: Tipo de Mantenimiento -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Tipo de Mantenimiento:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding TipoMantenimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="MANTENIMIENTO CORRECTIVO"/>
                                <ComboBoxItem Content="MANTENIMIENTO PREVENTIVO"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Columna 2, Fila 2: Horas / Kilómetros Reales -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Horas / Kilómetros Reales:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Horaskilometrosreales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Fila 3: Anotaciones / Observaciones -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                            <TextBlock Text="Anotaciones / Observaciones:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Anotaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="70" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="5"/>
                        </StackPanel>

                        <!-- Fila 4: Carga de Archivos Múltiples -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Archivos Adjuntos del Servicio:" Style="{StaticResource LabelStyle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Button Command="{Binding SeleccionarArchivosCommand}" 
                                        Content=" + Seleccionar Archivos " 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        HorizontalAlignment="Right" 
                                        Width="160"/>
                            </DockPanel>

                            <!-- Lista con las rutas de archivos seleccionados -->
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" MinHeight="60" MaxHeight="120">
                                <ItemsControl ItemsSource="{Binding ArchivosSeleccionados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="8,4">
                                                <Button Content="✕" 
                                                        Foreground="Red" 
                                                        FontWeight="Bold" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Cursor="Hand"
                                                        DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.EliminarArchivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#444444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Botón de Acción -->
                    <Button Command="{Binding AltaServicioCommand}" 
                            Content="Guardar Cambios" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right" 
                            Width="160"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>