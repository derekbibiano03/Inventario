                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton BorderThickness="1" Background="White" BorderBrush="Gray" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Content="Filtrar ▾"/>
