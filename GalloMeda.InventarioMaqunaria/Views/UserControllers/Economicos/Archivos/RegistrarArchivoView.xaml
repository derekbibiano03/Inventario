<UserControl x:Class="Inventario.Desktop.Views.UserControllers.Economicos.RegistrarArchivoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventario.Desktop.Views.UserControllers.Economicos"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Fila 0: Título -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Selección de Económicos -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 2: Selección Múltiple de Archivos -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 3: Previsualización de metadatos -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 4: Botones de acción -->
            </Grid.RowDefinitions>

            <!-- Título del Formulario -->
            <TextBlock Grid.Row="0" 
                       Text="Adjuntar Documentos o Imágenes a Económicos" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20" 
                       Foreground="#333333"/>

            <!-- Sección 1: Selección de Económicos -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Buscar y Seleccionar Económicos (Selección Múltiple):" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding TextoBusquedaId, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Buscar por ID..." 
                         Height="30" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,5"
                         Padding="5,0"/>

                <ListBox ItemsSource="{Binding EconomicosFiltrados}" 
                         Height="180" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IdEconomico}" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,10,0"/>
                                    <TextBlock Text=" - "/>
                                    <TextBlock Text="{Binding Descripcion}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Sección 2: Selección Múltiple de Archivos -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="Archivos Seleccionados (PDF o Imagen):" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <Button Content="Agregar Archivos..." 
                            Command="{Binding SeleccionarArchivosCommand}" 
                            Width="140" 
                            Height="30" 
                            HorizontalAlignment="Right"/>
                </Grid>

                <ListBox ItemsSource="{Binding ListaArchivosSeleccionados}" 
                         Height="120" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" ToolTip="{Binding}"/>
                                <Button Grid.Column="1" 
                                        Content="X" 
                                        Foreground="Red" 
                                        FontWeight="Bold" 
                                        Width="25" 
                                        Height="20" 
                                        Margin="10,0,0,0"
                                        Command="{Binding DataContext.EliminarArchivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Sección 3: Resumen -->
            <Border Grid.Row="3" 
                    Background="#FAFAFA" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15" 
                    Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Resumen de Carga" 
                               FontWeight="Bold" 
                               Foreground="#555555" 
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total de Archivos: " FontWeight="SemiBold" Margin="0,2,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ListaArchivosSeleccionados.Count}" Margin="0,2,0,2" Foreground="Blue" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha Alta: " FontWeight="SemiBold" Margin="0,2,10,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FechaAltaActual}" Margin="0,2,0,2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sección 4: Botones de Acción -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="Cancelar" 
                        Width="100" 
                        Height="35" 
                        Margin="0,0,10,0" 
                        Background="#E0E0E0" 
                        BorderBrush="{x:Null}"/>
                <Button Content="Guardar en Sistema" 
                        Command="{Binding GuardarArchivoCommand}" 
                        Width="150" 
                        Height="35" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderBrush="{x:Null}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>