                                                    <StackPanel>
                                                        <TextBlock Text="Buscar:" FontSize="10" Foreground="Gray"/>
                                                        <TextBox Width="165" Margin="0,2,0,5" Text="{Binding DataContext.BusquedaMarca, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
