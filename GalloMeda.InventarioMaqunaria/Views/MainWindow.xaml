<Window x:Class="Inventario.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventario.Desktop.Views"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icono.ico"
        Title="Inventario Maquinaria" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColumnaMenu" Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2A2D34">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#1E2022">
                    <TextBlock Style="{StaticResource TextoResaltado}" Padding="65,0,0,0"  Text="APARTADOS" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Content="☰" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" HorizontalAlignment="Right" Click="BtnColapsar_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/economicos_icon.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="ECONOMICOS ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">
                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- INFORMACION ECONOMICOS ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="INFORMACION DE ECONOMICOS" Tag="VerInventario" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="ALTAS ECONOMICOS" Tag="AgregarEconomico" Click="MenuItem_Click"/>

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- MOVIMIENTOS ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="NUEVO MOVIMIENTO DE ECONOMICO" Tag="MoverEconomico" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="HISTORIAL DE MOVIMIENTOS DE ECONOMICOS" Tag="HisMoverEconomico" Click="MenuItem_Click"/>

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- ARCHIVOS ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="SUBIR ARCHIVOS" Tag="AgregarArchivo" Click="MenuItem_Click"/>

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- SERVICIOS ---" 
                                                Foreground="#8A92A6" 
                                                FontWeight="Bold" 
                                                FontSize="11" 
                                                Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="VER SERVICIOS REALIZADOS" Tag="VerServicios" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="REGISTRAR 
                                              NUEVO SERVICIO" Tag="HistServ" Click="MenuItem_Click"/>

                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/empleado_icon.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="PERSONAL ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">
                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- PERSONAL ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="EMPLEADOS" Tag="VerOperadores" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="ENCARGADOS DE MAQUINARIA" Tag="VerEnMaq" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="PROPIETARIOS Y ADMINISTRADORES DE MAQUINARIA" Tag="ProAdmin" Click="MenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- 
                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/socios_icon.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="PROVEEDORES ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="Brokers" Tag="VerBrokers" Click="MenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        -->

                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/catalogo_icon.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="CATALOGOS ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- CATALOGOS ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE COMBUSTIBLES" Tag="CatCom" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE TIPOS DE EQUIPOS" Tag="CatTipEq" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE GRUPOS" Tag="CatGrp" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE TIPOS DE ESTATUS" Tag="CatTiEs" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE MARCAS" Tag="CatMarc" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE TIPOS DE ADQUISICIONES" Tag="CatAdqs" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CATALOGO DE TIPOS DE MATERIALES" Tag="CatMater" Click="MenuItem_Click"/>


                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/ubicacion_icon.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="UBICACIONES ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- UBICACIONES ---" 
                                                Foreground="#8A92A6" 
                                                FontWeight="Bold" 
                                                FontSize="11" 
                                                Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="UBICACION DE PROYECTOS" Tag="VerUbicaciones" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="TRAMOS" Tag="VerTramos" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="FRENTES" Tag="VerFrentes" Click="MenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/AgregarUsuario.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="CUENTAS ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">
                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- USUARIOS CON ACCESO ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="AGREGAR NUEVO USUARIO" Tag="AddUser" Click="MenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Height="60" Margin="0,2" Background="#3B3F4A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0" Click="BtnProductosMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/adquisiciones.png" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextoResaltado}" Text="ADQUISICIONES Y SERVICIOS ▾" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MenuModerno}">
                                    
                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- REQUISICIONES ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CREACION DE NUEVA REQUISICION" Tag="AddReq" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="BUSCAR REQUISICIONES" Tag="" Click="MenuItem_Click"/>

                                    <MenuItem IsEnabled="False" Background="#2A2D34" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="--- ORDENES DE COMPRA ---" 
                                               Foreground="#8A92A6" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,2"/>
                                        </MenuItem.Header>
                                    </MenuItem>

                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="CREACION DE NUEVA ORDEN DE COMPRA" Tag="" Click="MenuItem_Click"/>
                                    <MenuItem Style="{StaticResource TextoResaltadoBarra}" Header="BUSCAR ORDENES DE COMPRA" Tag="" Click="MenuItem_Click"/>

                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>


                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F5F6FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Name="BtnMostrarMenu" Content="☰ Menú" Width="70" Height="30" Background="#2A2D34" Foreground="White" BorderThickness="0" Visibility="Collapsed" Click="BtnMostrar_Click"/>
                        <TextBlock Style="{StaticResource TextoResaltado}" x:Name="txtPanel" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555555" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,10,0">
                        <TextBlock Text="👤 " Foreground="#2A2D34" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextoResaltado}" Text="{Binding UsuarioLogueado}" Foreground="#2A2D34" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Name="ContenedorPrincipal" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>